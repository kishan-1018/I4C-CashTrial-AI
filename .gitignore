# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# ─── Project-specific generated / runtime files ────────────────────────────────

# Audit ledger is runtime-generated and grows unboundedly — regenerated on startup
data/audit_ledger.json

# Large synthetic training datasets — regenerated by data/generator.py
# Keep demo_scenarios.json and registry files (they are curated fixtures)
data/complaints_train.json
data/complaints_test.json
data/complaints_validation.json

# ─── Sensitive / secrets ───────────────────────────────────────────────────────
.env
.env.*
secrets.toml
config.local.py

# ─── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.xml

